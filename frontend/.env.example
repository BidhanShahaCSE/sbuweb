# SBU Web Frontend Environment Configuration Example
# Copy to .env.local for local development.
# In Cloudflare Workers Dashboard, add these under Settings -> Variables and Secrets.

# Canonical Production URL
NEXT_PUBLIC_SITE_URL=https://sbutech.com

# Backend API Endpoint (Points to the decoupled Express backend)
NEXT_PUBLIC_API_URL=https://api.sbutech.com/api/v1

# Supabase Client Configuration (Optional / Future integration)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
